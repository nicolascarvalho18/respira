# URL base para consumo de API REST no futuro
# No emulador Android, 10.0.2.2 mapeia para o localhost da máquina host (onde o servidor Spring Boot rodará).
# No Expo Web ou iOS Simulator, use http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Modo de operação: 'mock' ou 'api' (padrão 'mock' para execução autônoma sem backend ativo)
EXPO_PUBLIC_DATA_SOURCE=mock
