# =====================================================================
# RESPIRA DIGITAL HEALTH PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Note: Never commit actual secret keys or credentials to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND / CLIENT ENVIRONMENT (Vite & Expo)
# ---------------------------------------------------------------------
# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Public - Safe for browser & mobile app)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# App Environment
NODE_ENV=development
EXPO_PUBLIC_DATA_SOURCE=mock

# ---------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE ONLY (Never exposed to browser or mobile client)
# ---------------------------------------------------------------------
# Supabase Admin / Service Role Secret Key (Server Only - Bypass RLS for migrations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# PostgreSQL Connection String (Optional direct DB connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/respira
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & JWT (Optional internal token auth)
JWT_SECRET=your-internal-jwt-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# LLM Educational AI Assistant (Server-Side Only)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=450
AI_TEMPERATURE=0.6

# CORS & Server
PORT=3000
ALLOWED_ORIGINS=https://respira-one.vercel.app,http://localhost:8081,http://localhost:8082
